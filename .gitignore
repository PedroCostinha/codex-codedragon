# Lista permitida: todo arquivo novo permanece ignorado por padrão.
*
!/.gitignore
!/.gitattributes
!/README.md
!/assets/
!/assets/reference/
!/assets/reference/codedragon.png
!/assets/source/
!/assets/source/v2-r2/
!/assets/source/v2-r2/*.png
!/assets/source/v2-r2/*.txt
!/assets/source/v2-r2/*.json
!/pets/
!/pets/codedragon/
!/pets/codedragon/pet-manifest.json
!/pets/codedragon/spritesheet.png
!/assets/previews/
!/assets/previews/*.png
!/assets/previews/*.gif
!/assets/previews/*.mp4
!/assets/qa/
!/assets/qa/*.json
!/tools/
!/tools/*.py
!/tools/pet_pipeline/
!/tools/pet_pipeline/*.py
!/tools/pet_pipeline/*.json
!/tools/requirements-dev.txt
!/docs/
!/docs/*.md
